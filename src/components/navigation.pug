nav.nav(aria-label='Main')
    ul.nav__list
        each link, i in navLinks
            li
                a.nav__link(href=link.href class=(link.active ? 'is-active' : false) aria-current=(i === 0 ? 'page' : false))= link.text
    .nav__extra
        +btn('Contact us', '#contact')
        +btn('Favourites', '#', 'ghost')