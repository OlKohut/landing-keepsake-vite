mixin icon(name, size = 40)
    case name
        when 'monitor'
            svg(width=size height=size viewBox='0 0 40 40' fill='none' stroke='#2cd5c4' stroke-width='2' aria-hidden='true')
                rect(x='6' y='9' width='28' height='19')
                path(d='M14 33h12M20 28v5')
        when 'phone'
            svg(width=size height=size viewBox='0 0 40 40' fill='none' stroke='#2cd5c4' stroke-width='2' aria-hidden='true')
                rect(x='9' y='5' width='22' height='30' rx='3')
                path(d='M18 30h4')
        when 'mail'
            svg(width=size height=size viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' aria-hidden='true')
                rect(x='3' y='5' width='18' height='14')
                path(d='M3 6l9 7 9-7')
        when 'photo'
            svg(width=size height=size viewBox='0 0 40 40' fill='none' stroke='#f95858' stroke-width='2' aria-hidden='true')
                path(d='M7 30l8-12 7 8 4-5 7 9z')
                circle(cx='28' cy='11' r='3')
        when 'heart'
            svg(width=size height=size viewBox='0 0 40 40' fill='#f95858' aria-hidden='true')
                path(d='M20 34s-13-8.5-13-18a7 7 0 0 1 13-3.5A7 7 0 0 1 33 16c0 9.5-13 18-13 18z')        
        default
            //- невідома іконка: нічого не виводимо